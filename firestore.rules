rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /games/{gameCode} {
      // Public game state: any authenticated (incl. anonymous) player
      // can read. Writes should really be locked down further (only
      // the current turn's player, validated fields, etc.) — start
      // here and tighten once turn logic is built.
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      // Per-player hidden hand. Only the matching UID can read its
      // own document. This is the field-level-visibility workaround:
      // Firestore can't hide individual fields on `games/{gameCode}`,
      // so hidden data lives in its own gated document instead.
      match /private/{uid} {
        allow read: if request.auth.uid == uid;
        allow write: if request.auth.uid == uid;

        // The host deals every hand once, up front, which means writing
        // documents that belong to other players' UIDs. Only allowed
        // while `dealt` is still false, so this can't be used to peek
        // at or rewrite hands mid-game.
        allow create: if request.auth.uid ==
                        get(/databases/$(database)/documents/games/$(gameCode)).data.players[0].id
                      && get(/databases/$(database)/documents/games/$(gameCode)).data.dealt == false;
      }

      // A record of a card shown during a "disprove" step — visible
      // only to the two players involved, not the whole table.
      match /disproves/{disproveId} {
        allow read: if request.auth.uid == resource.data.suggesterId
                     || request.auth.uid == resource.data.discloserId;
        // On create there is no existing `resource` yet, so the check
        // has to read the incoming write (`request.resource`), not the
        // (nonexistent) current document.
        allow create: if request.auth.uid == request.resource.data.discloserId;
      }

      // The hidden solution, dealt once alongside the hands. Not locked
      // down yet — any authenticated player could technically read it by
      // guessing the path. Tightening this is follow-up work once
      // accusations are built.
      match /solution/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
  }
}
